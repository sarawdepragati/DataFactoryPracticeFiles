{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "clinicaltrial-adf"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/dataflow_activity')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_patientinfo",
								"type": "DatasetReference"
							},
							"name": "sourcepatientsinfo"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sink_patientdata",
								"type": "DatasetReference"
							},
							"name": "sinkpatientsdata"
						}
					],
					"transformations": [
						{
							"name": "filterpatientdata"
						},
						{
							"name": "sortstatecodecitydata"
						},
						{
							"name": "derivedColumn"
						},
						{
							"name": "surrogateKey"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          state_code as string,",
						"          phone as string,",
						"          city as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     ignoreNoFilesFound: false) ~> sourcepatientsinfo",
						"sourcepatientsinfo filter(gender=='M') ~> filterpatientdata",
						"filterpatientdata sort(asc(state_code, true),",
						"     desc(city, true),",
						"     caseInsensitive: true) ~> sortstatecodecitydata",
						"sortstatecodecitydata derive(CurrentDateTime = currentTimestamp()) ~> derivedColumn",
						"derivedColumn keyGenerate(output(pt_sk as long),",
						"     startAt: 1L,",
						"     stepValue: 1L) ~> surrogateKey",
						"surrogateKey sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          sale_id as string,",
						"          product as string,",
						"          category as string,",
						"          quantity as string,",
						"          price as string,",
						"          sale_date as string,",
						"          region as string",
						"     ),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkpatientsdata"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflowjoins')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_azuresql_adls",
								"type": "LinkedServiceReference"
							},
							"name": "sourcejoins"
						},
						{
							"linkedService": {
								"referenceName": "ls_azuresql_adls",
								"type": "LinkedServiceReference"
							},
							"name": "sourcejoin2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_target_files1",
								"type": "DatasetReference"
							},
							"name": "sinkjoinstables",
							"rejectedDataLinkedService": {
								"referenceName": "ls_adls_gen_2",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "join1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          customer_id as integer,",
						"          customer_name as string,",
						"          gender as string,",
						"          city as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'RAW',",
						"     tableName: 'CUSTOMERS_NEW',",
						"     isolationLevel: 'READ_COMMITTED') ~> sourcejoins",
						"source(output(",
						"          order_id as integer,",
						"          customer_id as integer,",
						"          product_name as string,",
						"          amount as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'RAW',",
						"     tableName: 'ORDERS_NEW',",
						"     isolationLevel: 'READ_COMMITTED') ~> sourcejoin2",
						"sourcejoins, sourcejoin2 join(sourcejoins@customer_id == sourcejoin2@customer_id,",
						"     joinType:'outer',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"sourcejoin2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          sale_id as string,",
						"          product as string,",
						"          category as string,",
						"          quantity as string,",
						"          price as string,",
						"          sale_date as string,",
						"          region as string",
						"     ),",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkjoinstables"
					]
				}
			},
			"dependsOn": []
		},
